# ==========================================
# @ulustore/db - Database Environment Variables
# @ulustore/db - Veritabanı Mühit Dəyişənləri
# ==========================================
# 
# Bu faylı .env olaraq kopyalayın və dəyərləri doldurun.
# Copy this file as .env and fill in the values.
#
# ==========================================

# Pooler URL - Runtime bağlantısı üçün (port 6543)
# Pooler URL - For runtime connections (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL - Migrations üçün (port 5432)
# Direct URL - For migrations (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==========================================
# Necə əldə etmək olar / How to get these values:
# ==========================================
# 
# 1. Supabase Dashboard → Project Settings → Database
# 2. Connection String → URI formatı seçin
# 3. 
#    - DATABASE_URL: "Transaction pooler" seçin (port 6543)
#    - DIRECT_URL: "Session pooler" və ya "Direct" seçin (port 5432)
#
# ==========================================
