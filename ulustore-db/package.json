{
  "name": "@ulustore/db",
  "version": "1.0.0",
  "description": "ulustore.com platforması üçün ortaq database paketi / Shared database package for ulustore.com platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "generate": "prisma generate --schema=../../prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "studio": "prisma studio",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0",
    "@types/node": "^20.0.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "keywords": [
    "ulustore",
    "database",
    "prisma",
    "postgresql",
    "supabase"
  ],
  "author": "ulustore.com",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/ulustore/ulustore.com"
  }
}
